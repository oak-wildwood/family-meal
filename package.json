{
  "name": "family-meal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "recipe:check": "node scripts/check-recipe.mjs",
    "recipe:check:all": "node scripts/check-all-recipes.mjs",
    "recipe:index": "node scripts/build-index.mjs",
    "recipes:seed": "node scripts/import-recipes.mjs",
    "recipes:images": "node scripts/import-recipes.mjs --images",
    "icons": "node scripts/make-icons.mjs",
    "image:strip": "node scripts/strip-jpeg-metadata.mjs",
    "verify": "npm run test:ci && npm run build && npm run recipe:check:all"
  },
  "private": true,
  "packageManager": "npm@11.21.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.30",
    "@fontsource-variable/newsreader": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^24.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
